<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.laya.service</string>

  <key>ProgramArguments</key>
  <array>
    <string>__LAYA_ROOT__/.conda311/bin/python</string>
    <string>__LAYA_ROOT__/webui/server.py</string>
    <string>--port</string>
    <string>8077</string>
    <string>--preload</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__LAYA_ROOT__</string>

  <!-- Start at login and restart if it ever exits. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/laya-service.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/laya-service.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>LAYA_DEVICE</key>
    <string>cpu</string>
    <key>TOKENIZERS_PARALLELISM</key>
    <string>false</string>
  </dict>
</dict>
</plist>
